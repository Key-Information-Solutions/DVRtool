<!-- DVRTool per-machine MSI: GUI + CLI, public-desktop shortcut (optional),
     system PATH entry for the CLI, and an HKLM discovery key.
     Silent install:   msiexec /i DVRTool-x.y.z.msi /qn
     No desktop icon:  msiexec /i DVRTool-x.y.z.msi /qn DESKTOP_SHORTCUT=0
     See docs/installer.md. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="DVRTool"
           Manufacturer="Key Information Solutions"
           Version="$(var.ProductVersion)"
           UpgradeCode="69274A6A-8FC5-402D-BA21-211B55224DD4"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of DVRTool is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Public property: pass DESKTOP_SHORTCUT=0 to skip the public-desktop shortcut. -->
    <Property Id="DESKTOP_SHORTCUT" Value="1" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DVRTool">
        <Directory Id="GuiFolder" Name="app" />
        <Directory Id="CliFolder" Name="cli" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- Everything the two self-contained publishes produced. -->
    <ComponentGroup Id="GuiFiles" Directory="GuiFolder">
      <Files Include="$(var.GuiPublishDir)\**" />
    </ComponentGroup>
    <ComponentGroup Id="CliFiles" Directory="CliFolder">
      <Files Include="$(var.CliPublishDir)\**" />
    </ComponentGroup>

    <ComponentGroup Id="SystemIntegration">

      <!-- `dvrtool` on every shell: append the CLI folder to the system PATH.
           Removed again on uninstall (Permanent=no). -->
      <Component Id="PathEnvironment" Directory="CliFolder" Guid="93F0D3D5-29BE-4418-B737-BF43CD8CC412">
        <Environment Id="DvrToolPath" Name="PATH" Value="[CliFolder]"
                     Part="last" Action="set" Permanent="no" System="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\DVRTool" Name="PathEnvironment"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Discovery key for scripts and other programs. -->
      <Component Id="DiscoveryRegistry" Directory="INSTALLFOLDER" Guid="3C57F29B-679A-4500-9FD3-F5A337495B7F">
        <RegistryKey Root="HKLM" Key="SOFTWARE\DVRTool">
          <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
          <RegistryValue Name="GuiExe" Type="string" Value="[GuiFolder]DVRTool.exe" />
          <RegistryValue Name="CliExe" Type="string" Value="[CliFolder]dvrtool.exe" />
          <RegistryValue Name="Version" Type="string" Value="$(var.ProductVersion)" KeyPath="yes" />
        </RegistryKey>
      </Component>

      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="D7A12DC8-4A76-4317-A6AB-FC628A8382A8">
        <Shortcut Id="StartMenuGui" Name="DVRTool"
                  Target="[GuiFolder]DVRTool.exe" WorkingDirectory="GuiFolder" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\DVRTool" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Per-machine install, so DesktopFolder is C:\Users\Public\Desktop. -->
      <Component Id="DesktopShortcut" Directory="DesktopFolder"
                 Guid="808A03ED-7356-466A-BD60-EBDCDFA136F6" Condition="DESKTOP_SHORTCUT=1">
        <Shortcut Id="DesktopGui" Name="DVRTool"
                  Target="[GuiFolder]DVRTool.exe" WorkingDirectory="GuiFolder" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\DVRTool" Name="DesktopShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <Feature Id="Main" Level="1">
      <ComponentGroupRef Id="GuiFiles" />
      <ComponentGroupRef Id="CliFiles" />
      <ComponentGroupRef Id="SystemIntegration" />
    </Feature>

  </Package>
</Wix>
