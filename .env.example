# Copy to .env (gitignored) — the CLI reads these automatically.
DVR_HOST=192.0.2.10
DVR_USER=admin
DVR_PASS=

# --- Access-control door panels (Hikvision DS-K / OEM "OCB") ---
# A separate device class from the NVRs: SDK port 8000 only, no HTTP interface.
# Needs Windows + HCNetSDK.dll (iVMS-4200 or HikCentral Lite ships it).
OCB_PANELS=192.0.2.221,192.0.2.222,192.0.2.223
OCB_USER=admin
OCB_PASS=
OCB_SDK_PORT=8000
# Only if the SDK is somewhere unusual:
#OCB_SDK_DIR=C:\Program Files (x86)\HikCentral Lite\Client
