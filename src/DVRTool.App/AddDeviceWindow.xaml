<Window x:Class="DVRTool.App.AddDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add NVR" Height="620" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
        <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,3"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Vendor" VerticalAlignment="Center"/>
        <ComboBox x:Name="VendorCombo" Grid.Row="1" Grid.Column="1" Margin="0,3" SelectedIndex="0"
                  SelectionChanged="OnVendorChanged">
            <ComboBoxItem Content="Hikvision / LTS"/>
            <ComboBoxItem Content="Dahua / Amcrest"/>
        </ComboBox>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Host / IP" VerticalAlignment="Center"/>
        <TextBox x:Name="HostBox" Grid.Row="2" Grid.Column="1" Margin="0,3"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="HTTP port" VerticalAlignment="Center"/>
        <TextBox x:Name="HttpPortBox" Grid.Row="3" Grid.Column="1" Margin="0,3" Text="80"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="RTSP port" VerticalAlignment="Center"/>
        <TextBox x:Name="RtspPortBox" Grid.Row="4" Grid.Column="1" Margin="0,3" Text="554"/>

        <!-- Label, default and hint are all rewritten by OnVendorChanged: the vendors put
             this port in different places and call it different things. -->
        <TextBlock x:Name="SdkPortLabel" Grid.Row="5" Grid.Column="0" Text="SDK port"
                   VerticalAlignment="Center"/>
        <TextBox x:Name="SdkPortBox" Grid.Row="5" Grid.Column="1" Margin="0,3" Text="8000"/>

        <TextBlock x:Name="SdkPortHint" Grid.Row="6" Grid.Column="1" Margin="0,0,0,4"
                   TextWrapping="Wrap" FontStyle="Italic" Foreground="Gray"/>

        <CheckBox x:Name="TlsCheck" Grid.Row="7" Grid.Column="1" Margin="0,3"
                  Content="Use HTTPS (cert pinned on first use)"
                  Checked="OnTlsChecked" Unchecked="OnTlsUnchecked"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Username" VerticalAlignment="Center"/>
        <TextBox x:Name="UserBox" Grid.Row="8" Grid.Column="1" Margin="0,3"/>

        <TextBlock Grid.Row="9" Grid.Column="0" Text="Password" VerticalAlignment="Center"/>
        <PasswordBox x:Name="PassBox" Grid.Row="9" Grid.Column="1" Margin="0,3"/>

        <TextBlock x:Name="PasswordHint" Grid.Row="10" Grid.Column="1"
                   Text="Leave blank to keep the current password."
                   FontStyle="Italic" Foreground="Gray" Visibility="Collapsed"/>

        <!-- Edit mode only: which physical recorder this record is bound to. Shown because
             the binding is what refuses a connection when a port starts forwarding somewhere
             else, so the operator has to be able to see it and, deliberately, release it. -->
        <StackPanel x:Name="IdentityRow" Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock x:Name="IdentityText" TextWrapping="Wrap" MaxWidth="290"
                       VerticalAlignment="Center" Foreground="Gray" FontStyle="Italic"/>
            <Button x:Name="UnbindButton" Content="Unbind" Click="OnUnbind" Margin="8,0,0,0"
                    Padding="8,2"/>
        </StackPanel>

        <StackPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="TestButton" Content="Test connection" Click="OnTest" Padding="10,4"/>
            <Button Content="Save" Click="OnSave" Margin="8,0,0,0" Padding="14,4" IsDefault="True"/>
            <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0" Padding="10,4"/>
        </StackPanel>

        <!-- Scrolls because four wrapped result lines can outgrow the fixed dialog. -->
        <ScrollViewer Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="TestResults"/>
        </ScrollViewer>
    </Grid>
</Window>
