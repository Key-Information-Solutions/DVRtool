<Window x:Class="DVRTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:local="clr-namespace:DVRTool.App"
        Title="DVRTool — Key Information Solutions"
        Height="760" Width="1220"
        Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnLivePreviewKeyDown">
    <DockPanel>
        <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom">
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="LiveStatsText" Visibility="Collapsed" Margin="12,0,4,0"
                           FontFamily="Consolas, Segoe UI">
                    <TextBlock.ToolTip>
                        <TextBlock>
                            The selected camera's stream, as this viewer receives it, sampled once a second:<LineBreak/>
                            codec, picture size, decoded frames per second and received bitrate.<LineBreak/>
                            <LineBreak/>
                            <Bold>dropped</Bold> counts pictures the viewer could not show in time — a viewer<LineBreak/>
                            or link problem, not a camera problem. <Bold>dropped by viewer</Bold> is the SDK<LineBreak/>
                            route's buffer discarding bytes because the decoder fell behind.<LineBreak/>
                            <LineBreak/>
                            In the grid, click a camera to select it; the maximized camera is always selected.
                        </TextBlock>
                    </TextBlock.ToolTip>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <!-- Version, install location, last update check, and a manual check. -->
                <Button x:Name="AboutButton" Content="?" Width="22" Padding="0" Margin="0,0,4,0"
                        Click="OnAbout" ToolTip="About DVRTool / check for updates"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Update banner: shown only when a signed newer release is available. Never modal,
             never steals focus from a live view; MainWindow.Updates.cs owns it. -->
        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="#FFF4E5" BorderBrush="#E0B56A" BorderThickness="0,0,0,1" Padding="10,5">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Width="22" Padding="0" Margin="8,0,0,0"
                        Click="OnUpdateDismiss" ToolTip="Hide until next time"/>
                <Button DockPanel.Dock="Right" Content="Skip this version" Padding="8,2" Margin="8,0,0,0"
                        Click="OnUpdateSkip"/>
                <Button DockPanel.Dock="Right" Content="Install now" Padding="8,2" Margin="8,0,0,0"
                        FontWeight="Bold" Click="OnUpdateInstall"/>
                <Button DockPanel.Dock="Right" Content="What's new" Padding="8,2" Margin="8,0,0,0"
                        Click="OnUpdateNotes"/>
                <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center"
                           Text="A newer DVRTool is available."/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidePanelColumn" Width="290"/>
                <ColumnDefinition x:Name="SidePanelSplitterColumn" Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel x:Name="SidePanel" Grid.Column="0" Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Add Device…" Click="OnAddDevice" Padding="10,4"/>
                    <Button Content="Edit…" Click="OnEditDevice" Margin="6,0,0,0" Padding="10,4"/>
                    <Button Content="Remove" Click="OnRemoveDevice" Margin="6,0,0,0" Padding="10,4"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="Devices" FontWeight="Bold"/>
                <ListBox x:Name="DeviceList" DockPanel.Dock="Top" Height="170"
                         DisplayMemberPath="DisplayLabel" SelectionChanged="OnDeviceSelected"
                         MouseDoubleClick="OnDeviceListDoubleClick"
                         Margin="0,2,0,10"/>
                <TextBlock DockPanel.Dock="Top" Text="Channels" FontWeight="Bold"/>
                <ListBox x:Name="ChannelList" Margin="0,2,0,0" DisplayMemberPath="Display"
                         SelectionChanged="OnChannelSelected"/>
            </DockPanel>

            <GridSplitter x:Name="SidePanelSplitter" Grid.Column="1" HorizontalAlignment="Stretch"/>

            <TabControl x:Name="MainTabs" Grid.Column="2" Margin="8" SelectionChanged="OnMainTabChanged">
                <TabItem x:Name="LiveTab" Header="Live">
                    <DockPanel>
                        <ToolBar x:Name="LiveToolBar" DockPanel.Dock="Top">
                            <TextBlock Text="Stream: " VerticalAlignment="Center"/>
                            <ComboBox x:Name="LiveStreamCombo" Width="80" SelectedIndex="0">
                                <ComboBoxItem Content="Main"/>
                                <ComboBoxItem Content="Sub"/>
                            </ComboBox>
                            <TextBlock Text=" over " VerticalAlignment="Center"/>
                            <ComboBox x:Name="LiveTransportCombo" Width="130" SelectedIndex="1">
                                <ComboBoxItem x:Name="LiveTransportRtsp" Content="RTSP"/>
                                <ComboBoxItem x:Name="LiveTransportSdk" Content="SDK"/>
                                <ComboBox.ToolTip>
                                    <TextBlock>
                                        Which port the video comes over.<LineBreak/>
                                        <LineBreak/>
                                        <Bold>RTSP</Bold> is the standard route, and needs the RTSP port forwarded.<LineBreak/>
                                        Most sites do not forward it.<LineBreak/>
                                        <LineBreak/>
                                        <Bold>SDK</Bold> is Hikvision's private protocol, which carries the video back<LineBreak/>
                                        over the same port it logs in on — so it works wherever iVMS-4200<LineBreak/>
                                        works, with nothing forwarded but the SDK port. Hikvision only,<LineBreak/>
                                        and it needs HCNetSDK.dll (iVMS-4200 or HikCentral installs it).<LineBreak/>
                                        Each viewer uses one of the recorder's stream slots.<LineBreak/>
                                        <LineBreak/>
                                        A Hikvision recorder is selected on <Bold>SDK</Bold>, because that is the<LineBreak/>
                                        port most sites forward; everything else, and a machine with no<LineBreak/>
                                        HCNetSDK.dll, is selected on RTSP. Change it here per device.
                                    </TextBlock>
                                </ComboBox.ToolTip>
                            </ComboBox>
                            <Button Content="▶ Play" Click="OnLivePlay" Margin="8,0,0,0"/>
                            <Button Content="⏹ Stop" Click="OnLiveStop"/>
                            <Separator/>
                            <ToggleButton x:Name="LiveGridToggle" Content="▦ Grid" Padding="6,2"
                                          Checked="OnLiveGridToggle" Unchecked="OnLiveGridToggle">
                                <ToggleButton.ToolTip>
                                    <TextBlock>
                                        Every camera of the selected system at once, sub streams,<LineBreak/>
                                        up to 16 per page. Double-click a camera to see it full-size<LineBreak/>
                                        on its main stream; double-click again (or Esc) to come back.<LineBreak/>
                                        <LineBreak/>
                                        Each tile is a stream slot on the recorder and one TCP<LineBreak/>
                                        connection on the chosen port, so a full page is 16 of each —<LineBreak/>
                                        the same as an iVMS-4200 4×4 view.<LineBreak/>
                                        <LineBreak/>
                                        The wheel zooms whichever camera the pointer is over, a drag<LineBreak/>
                                        pans it and a right-click fits it again.
                                    </TextBlock>
                                </ToggleButton.ToolTip>
                            </ToggleButton>
                            <Button x:Name="LiveGridPrev" Content="◀" Click="OnLiveGridPrev" IsEnabled="False"
                                    ToolTip="Previous page of cameras"/>
                            <TextBlock x:Name="LiveGridPageLabel" VerticalAlignment="Center" Margin="4,0"/>
                            <Button x:Name="LiveGridNext" Content="▶" Click="OnLiveGridNext" IsEnabled="False"
                                    ToolTip="Next page of cameras"/>
                            <Separator/>
                            <ToggleButton x:Name="LiveDewarpToggle" Content="◎ Fisheye" Padding="6,2"
                                          IsEnabled="False"
                                          Checked="OnLiveDewarpToggle" Unchecked="OnLiveDewarpToggle">
                                <ToggleButton.ToolTip>
                                    <TextBlock>
                                        Dewarps this camera's fisheye picture — drag to aim, wheel to zoom.<LineBreak/>
                                        <LineBreak/>
                                        It replaces the plain view of the <Bold>one</Bold> camera on screen, so it is<LineBreak/>
                                        offered in the single view and on a maximized grid camera, never<LineBreak/>
                                        across a whole grid page: a dewarp wants the full-resolution picture,<LineBreak/>
                                        and sixteen of those is not a viewing mode.<LineBreak/>
                                        <LineBreak/>
                                        The stream is re-opened through the decoder this needs, so turning it<LineBreak/>
                                        on or off restarts the picture. Turning it off brings the plain view back.
                                    </TextBlock>
                                </ToggleButton.ToolTip>
                            </ToggleButton>
                            <TextBlock x:Name="LiveGridHint" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Foreground="Gray" Visibility="Collapsed"
                                       Text="double-click a camera for its main stream · wheel zooms, drag pans"/>
                            <Separator/>
                            <ToggleButton x:Name="LiveOneToOneButton" Content="1:1" Padding="6,2"
                                          Click="OnLiveOneToOne">
                                <ToggleButton.ToolTip>
                                    <TextBlock>
                                        Shows the camera at its real size: one camera pixel per screen<LineBreak/>
                                        pixel, centred where the picture is centred now. Applies to the<LineBreak/>
                                        single view, a maximized camera, or the selected grid tile.<LineBreak/>
                                        <LineBreak/>
                                        Drag to pan. The wheel zooms on from there and un-presses this<LineBreak/>
                                        button; a right-click or pressing it again fits the whole picture.<LineBreak/>
                                        Going fullscreen or resizing the window re-solves 1:1 for the new pane.
                                    </TextBlock>
                                </ToggleButton.ToolTip>
                            </ToggleButton>
                            <Button x:Name="LiveFullScreenButton" Content="&#x26F6; Full screen"
                                    Click="OnLiveFullScreen" Padding="6,2">
                                <Button.ToolTip>
                                    <TextBlock>
                                        Fills the screen with the video — the device list, the toolbars and<LineBreak/>
                                        the status bar go away, and nothing about the streams changes.<LineBreak/>
                                        <LineBreak/>
                                        <Bold>F11</Bold> toggles it, <Bold>Esc</Bold> comes back, and in the grid<LineBreak/>
                                        <Bold>PgUp</Bold> / <Bold>PgDn</Bold> turn the page without the toolbar.
                                    </TextBlock>
                                </Button.ToolTip>
                            </Button>
                        </ToolBar>
                        <StackPanel x:Name="DewarpToolBars" DockPanel.Dock="Top" Visibility="Collapsed">
                            <ToolBar>
                                <TextBlock Text="View: " VerticalAlignment="Center"/>
                                <ComboBox x:Name="DewarpModeCombo" Width="120" SelectionChanged="OnDewarpViewSettingChanged"/>
                                <TextBlock Text=" Mount: " VerticalAlignment="Center"/>
                                <ComboBox x:Name="DewarpMountCombo" Width="80" SelectionChanged="OnDewarpCalibrationSettingChanged"/>
                                <TextBlock Text=" Lens: " VerticalAlignment="Center"/>
                                <ComboBox x:Name="DewarpLensCombo" Width="130" SelectionChanged="OnDewarpCalibrationSettingChanged"/>
                                <Separator/>
                                <Button Content="Reset view" Click="OnDewarpResetView"
                                        ToolTip="Back to the opening view for this mount and view shape."/>
                                <Separator/>
                                <TextBlock Text="Renderer: " VerticalAlignment="Center"/>
                                <ComboBox x:Name="DewarpRendererCombo" Width="70" SelectedIndex="0"
                                          SelectionChanged="OnDewarpRendererChanged">
                                    <ComboBoxItem Content="Auto"/>
                                    <ComboBoxItem Content="GPU"/>
                                    <ComboBoxItem Content="CPU"/>
                                    <ComboBox.ToolTip>
                                        <TextBlock>
                                            Auto uses the graphics card unless this session cannot show its output<LineBreak/>
                                            (Remote Desktop, software rendering) — then the CPU renderer.<LineBreak/>
                                            GPU forces the card; CPU forces the fallback. The status line says which is drawing.
                                        </TextBlock>
                                    </ComboBox.ToolTip>
                                </ComboBox>
                                <Button Content="Test pattern" Click="OnDewarpTestPattern" Margin="8,0,0,0">
                                    <Button.ToolTip>
                                        <TextBlock>
                                            Shows a synthetic tiled floor seen through the current calibration, no camera needed.<LineBreak/>
                                            In the flat view the grout lines must come out straight; one half of the floor<LineBreak/>
                                            is tinted red and the other blue, so a mirrored picture is obvious.
                                        </TextBlock>
                                    </Button.ToolTip>
                                </Button>
                            </ToolBar>
                            <ToolBar>
                                <TextBlock Text="Circle: X " VerticalAlignment="Center"
                                           ToolTip="Where the image circle sits in the frame, in source pixels, and the lens's full field of view in degrees."/>
                                <TextBox x:Name="DewarpCenterXBox" Width="55" ToolTip="Circle centre X, in source pixels"/>
                                <TextBlock Text=" Y " VerticalAlignment="Center"/>
                                <TextBox x:Name="DewarpCenterYBox" Width="55" ToolTip="Circle centre Y, in source pixels"/>
                                <TextBlock Text=" r " VerticalAlignment="Center"/>
                                <TextBox x:Name="DewarpRadiusBox" Width="55" ToolTip="Circle radius, in source pixels"/>
                                <TextBlock Text=" FOV° " VerticalAlignment="Center"/>
                                <TextBox x:Name="DewarpFovBox" Width="45" ToolTip="The lens's full field of view, in degrees (180 for most fisheyes)"/>
                                <Button Content="Apply" Click="OnDewarpApplyCalibration" Margin="8,0,0,0"/>
                                <Button Content="Default" Click="OnDewarpDefaultCalibration"
                                        ToolTip="Circle inscribed in the shorter side and centred, 180° — right for most ceiling fisheyes."/>
                                <TextBlock x:Name="DewarpCalibrationNote" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                            </ToolBar>
                        </StackPanel>
                        <TextBlock x:Name="DewarpStatusText" DockPanel.Dock="Bottom" Margin="2,4,2,0"
                                   Foreground="Gray" TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="Drag to aim, wheel to zoom."/>
                        <Border Background="Black">
                            <Grid>
                                <vlc:VideoView x:Name="LiveVideo">
                                    <!-- An all-but-transparent overlay so the wheel, a drag and a
                                         right-click reach the single view: a VideoView is a hosted
                                         child window, and WPF sees no mouse input over it otherwise.
                                         Fully transparent pixels in the overlay's layered window are
                                         not hit-tested at all, hence the one unit of alpha. -->
                                    <Grid x:Name="LiveVideoOverlay" Background="#01000000">
                                        <TextBlock x:Name="LiveVideoLabel" Visibility="Collapsed"
                                                   Foreground="White" Background="#80000000"
                                                   Padding="6,2,6,3" FontSize="12"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    </Grid>
                                </vlc:VideoView>
                                <UniformGrid x:Name="LiveGridPanel" Visibility="Collapsed"/>
                                <vlc:VideoView x:Name="LiveMaxVideo" Visibility="Collapsed"/>
                                <local:DewarpSurface x:Name="DewarpPane" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Playback / Export" x:Name="PlaybackTab">
                    <DockPanel>
                        <ToolBar DockPanel.Dock="Top">
                            <Button Content="◀" Click="OnPlaybackPrevDay" ToolTip="Previous day"/>
                            <DatePicker x:Name="PlaybackDatePicker" Width="125"
                                        SelectedDateChanged="OnPlaybackDateChanged"/>
                            <Button Content="▶" Click="OnPlaybackNextDay" ToolTip="Next day"/>
                            <TextBlock x:Name="PlaybackDaysText" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <Separator/>
                            <TextBlock Text="Stream: " VerticalAlignment="Center"/>
                            <ComboBox x:Name="PlaybackStreamCombo" Width="70" SelectedIndex="0"
                                      SelectionChanged="OnPlaybackStreamChanged">
                                <ComboBoxItem Content="Main"/>
                                <ComboBoxItem Content="Sub"/>
                            </ComboBox>
                            <Separator/>
                            <Button Content="Zoom −" Click="OnPlaybackZoomOut"/>
                            <Button Content="Zoom +" Click="OnPlaybackZoomIn"/>
                            <Button Content="Whole day" Click="OnPlaybackZoomDay"/>
                            <Separator/>
                            <ToggleButton x:Name="ResultsToggle" Content="Segment list"
                                          Checked="OnResultsToggle" Unchecked="OnResultsToggle"/>
                            <ToolBar.ToolTip>
                                <TextBlock>
                                    Recorded footage for the selected camera, one day at a time.<LineBreak/>
                                    <LineBreak/>
                                    Video comes over the recorder's <Bold>web port</Bold> — the same port the export<LineBreak/>
                                    uses — so it plays wherever this tool can log in; RTSP is not needed.<LineBreak/>
                                    Dahua footage passes through ffmpeg on the way (it must be on PATH).<LineBreak/>
                                    <LineBreak/>
                                    On the timeline: click to play from there, drag to select a clip to<LineBreak/>
                                    export (or type its start and end in the Clip boxes), wheel to zoom,<LineBreak/>
                                    right-drag to pan.
                                </TextBlock>
                            </ToolBar.ToolTip>
                        </ToolBar>

                        <ToolBar DockPanel.Dock="Bottom">
                            <Button x:Name="PlaybackPlayPauseButton" Content="▶ Play" Width="90"
                                    Click="OnPlaybackPlayPause"/>
                            <Button Content="⏹ Stop" Click="OnPlaybackStop"/>
                            <TextBlock Text=" Speed " VerticalAlignment="Center"/>
                            <ComboBox x:Name="PlaybackSpeedCombo" Width="60" SelectedIndex="0"
                                      SelectionChanged="OnPlaybackSpeedChanged">
                                <ComboBoxItem Content="1×"/>
                                <ComboBoxItem Content="2×"/>
                                <ComboBoxItem Content="4×"/>
                                <ComboBoxItem Content="8×"/>
                            </ComboBox>
                            <ToggleButton x:Name="PlaybackOneToOneButton" Content="1:1" Padding="6,2"
                                          Click="OnPlaybackOneToOne">
                                <ToggleButton.ToolTip>
                                    <TextBlock>
                                        Shows the recording at its real size: one camera pixel per screen<LineBreak/>
                                        pixel. Drag the picture to pan; the wheel zooms on from there and<LineBreak/>
                                        un-presses this button; a right-click or pressing it again fits.
                                    </TextBlock>
                                </ToggleButton.ToolTip>
                            </ToggleButton>
                            <Separator/>
                            <TextBlock x:Name="PlaybackClockText" FontFamily="Consolas, Segoe UI"
                                       VerticalAlignment="Center" MinWidth="210" Margin="4,0"/>
                            <Separator/>
                            <TextBlock Text="Clip " VerticalAlignment="Center"/>
                            <TextBox x:Name="ClipStartBox" Width="70" VerticalAlignment="Center"
                                     FontFamily="Consolas, Segoe UI" LostFocus="OnClipRangeCommit"
                                     KeyDown="OnClipRangeKeyDown" ToolTip="Clip start on this day, HH:mm or HH:mm:ss — type it, or drag on the timeline"/>
                            <TextBlock Text=" → " VerticalAlignment="Center"/>
                            <TextBox x:Name="ClipEndBox" Width="70" VerticalAlignment="Center"
                                     FontFamily="Consolas, Segoe UI" LostFocus="OnClipRangeCommit"
                                     KeyDown="OnClipRangeKeyDown" ToolTip="Clip end on this day, HH:mm or HH:mm:ss (24:00 = midnight) — type it, or drag on the timeline"/>
                            <Button Content="⬇ Export clip…" Click="OnExportSelection" Margin="4,0,0,0"
                                    ToolTip="Exports the clip above: the range dragged on the timeline, or typed here"/>
                            <Button Content="⬇ Download segment…" Click="OnDownloadSegment"
                                    ToolTip="The row selected in the segment list"/>
                            <CheckBox x:Name="RemuxCheck" Content="Remux to a playable file"
                                      IsChecked="True" VerticalAlignment="Center" Margin="4,0">
                                <CheckBox.ToolTip>
                                    <TextBlock>
                                        Applies to both &quot;Export clip&quot; and &quot;Download segment&quot;.<LineBreak/>
                                        <LineBreak/>
                                        NVR exports are MPEG program streams (Hikvision) or DHAV/.dav<LineBreak/>
                                        (Dahua) whatever they are named, and most players outside VLC<LineBreak/>
                                        refuse them. This rebuilds the container with ffmpeg as a stream<LineBreak/>
                                        copy — nothing is re-encoded, so the footage stays bit-identical<LineBreak/>
                                        evidence. Requires ffmpeg on PATH.
                                    </TextBlock>
                                </CheckBox.ToolTip>
                            </CheckBox>
                            <Separator/>
                            <ProgressBar x:Name="DownloadProgress" Width="140" Height="14"/>
                            <TextBlock x:Name="DownloadLabel" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </ToolBar>

                        <TextBlock x:Name="PlaybackSelectionText" DockPanel.Dock="Bottom" Margin="2,0,2,2"
                                   Foreground="Gray"/>
                        <local:TimelineControl x:Name="PlaybackTimeline" DockPanel.Dock="Bottom"
                                               Height="64" Margin="0,4,0,2"/>

                        <DataGrid x:Name="ResultsGrid" DockPanel.Dock="Bottom" Height="150"
                                  Visibility="Collapsed" AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionMode="Single" Margin="0,4,0,0"
                                  MouseDoubleClick="OnResultDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ch" Width="50"
                                                    Binding="{Binding Channel}"/>
                                <DataGridTextColumn Header="Start" Width="150">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Start" StringFormat="yyyy-MM-dd HH:mm:ss"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="End" Width="150">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="End" StringFormat="yyyy-MM-dd HH:mm:ss"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Duration" Width="90"
                                                    Binding="{Binding Duration}"/>
                                <DataGridTextColumn Header="Type" Width="100"
                                                    Binding="{Binding Type}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="Black">
                            <vlc:VideoView x:Name="PlaybackVideo">
                                <!-- Same trick as the Live view: an all-but-transparent overlay so the
                                     wheel, a drag and a right-click reach a hosted child window. -->
                                <Grid x:Name="PlaybackVideoOverlay" Background="#01000000">
                                    <TextBlock x:Name="PlaybackVideoLabel" Visibility="Collapsed"
                                               Foreground="White" Background="#80000000"
                                               Padding="6,2,6,3" FontSize="12"
                                               HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                </Grid>
                            </vlc:VideoView>
                        </Border>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Users">
                    <DockPanel>
                        <ToolBar DockPanel.Dock="Top">
                            <TextBlock Text="Manage " VerticalAlignment="Center"/>
                            <ComboBox x:Name="UsersModeCombo" Width="200" SelectedIndex="0"
                                      SelectionChanged="OnUsersModeChanged">
                                <ComboBoxItem Content="DVR / NVR user accounts"/>
                                <ComboBoxItem Content="Access control (cardholders)"/>
                                <ComboBox.ToolTip>
                                    <TextBlock>
                                        The two kinds of “user” a fleet has, on different hardware:<LineBreak/>
                                        <LineBreak/>
                                        <Bold>DVR / NVR user accounts</Bold> — the login accounts on the<LineBreak/>
                                        recorders themselves. Read-only: the grid audits who exists<LineBreak/>
                                        where, and whether levels agree across a chain's devices.<LineBreak/>
                                        <LineBreak/>
                                        <Bold>Access control</Bold> — the fobs on the door panels, one row<LineBreak/>
                                        per fob, one column per panel. Names come from the iVMS<LineBreak/>
                                        import on the Access tab. Reads only; grants and revokes<LineBreak/>
                                        stay in the CLI behind --force.
                                    </TextBlock>
                                </ComboBox.ToolTip>
                            </ComboBox>
                            <TextBlock Text=" on " VerticalAlignment="Center"/>
                            <local:DevicePicker x:Name="UsersDevices" Width="230"/>
                            <Button Content="Load" Click="OnLoadUsers" Margin="8,0,0,0"/>
                        </ToolBar>

                        <TextBlock x:Name="UsersWarning" DockPanel.Dock="Top" Margin="2,4,2,0"
                                   TextWrapping="Wrap" Foreground="DarkRed" FontWeight="Bold"
                                   Visibility="Collapsed"/>

                        <!-- Columns are built in code per load: one per selected device. -->
                        <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" Margin="0,4"/>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Access">
                    <DockPanel>
                        <ToolBar DockPanel.Dock="Top">
                            <TextBlock Text="Panels " VerticalAlignment="Center"/>
                            <local:DevicePicker x:Name="AccessPanelsPicker" Width="150">
                                <local:DevicePicker.ToolTip>
                                    <TextBlock>
                                        Saved door panels (Add Device… → Door access panel). Each connects<LineBreak/>
                                        with its own saved credentials and port, and is pinned to its serial<LineBreak/>
                                        — one that later answers as a different controller is reported<LineBreak/>
                                        instead of being folded into the roster.
                                    </TextBlock>
                                </local:DevicePicker.ToolTip>
                            </local:DevicePicker>
                            <TextBlock Text=" + " VerticalAlignment="Center"/>
                            <TextBox x:Name="AccessPanelsBox" Width="130">
                                <TextBox.ToolTip>
                                    <TextBlock>
                                        Extra one-off panel addresses, comma separated<LineBreak/>
                                        (e.g. 192.0.2.221,192.0.2.222) — read alongside the saved<LineBreak/>
                                        panels, using the User/Password/SDK port boxes to the right.<LineBreak/>
                                        <LineBreak/>
                                        Add a port to an entry when several controllers sit behind one address<LineBreak/>
                                        (10.0.0.5,10.0.0.5:8001) — the port is then the only thing telling them<LineBreak/>
                                        apart, since one account opens all of them. The SDK port box is the<LineBreak/>
                                        default for entries without one.<LineBreak/>
                                        <LineBreak/>
                                        Every panel is read: door rights are per-panel, and a fob present on<LineBreak/>
                                        one controller says nothing about the others. Each is identified by<LineBreak/>
                                        serial on first read; one that later answers as a different controller<LineBreak/>
                                        is reported instead of being folded into the roster.
                                    </TextBlock>
                                </TextBox.ToolTip>
                            </TextBox>
                            <TextBlock Text=" User " VerticalAlignment="Center"/>
                            <TextBox x:Name="AccessUserBox" Width="85"/>
                            <TextBlock Text=" Password " VerticalAlignment="Center"/>
                            <PasswordBox x:Name="AccessPassBox" Width="85"/>
                            <TextBlock Text=" SDK port " VerticalAlignment="Center"
                                       ToolTip="Default SDK port for panel entries that do not carry one."/>
                            <TextBox x:Name="AccessPortBox" Width="45" Text="8000"/>
                            <TextBlock Text=" SDK dir " VerticalAlignment="Center"/>
                            <TextBox x:Name="AccessSdkDirBox" Width="110">
                                <TextBox.ToolTip>
                                    <TextBlock>
                                        Optional. Folder holding HCNetSDK.dll — iVMS-4200 and HikCentral<LineBreak/>
                                        Lite bundle it, and those install paths are probed automatically.
                                    </TextBlock>
                                </TextBox.ToolTip>
                            </TextBox>
                            <Button Content="Load roster" Click="OnLoadRoster" Margin="8,0,0,0"/>
                        </ToolBar>

                        <TextBlock x:Name="AccessWarning" DockPanel.Dock="Top" Margin="2,4,2,0"
                                   TextWrapping="Wrap" Foreground="DarkRed" FontWeight="Bold"
                                   Visibility="Collapsed"/>

                        <GroupBox DockPanel.Dock="Bottom" Margin="0,6,0,0"
                                  Header="Cardholder names (from iVMS)">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="IdentityStatus" Grid.Row="0" Grid.Column="0"
                                           Grid.ColumnSpan="3" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="iVMS database"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="IvmsDbBox" Grid.Row="1" Grid.Column="1" Margin="0,3">
                                    <TextBox.ToolTip>
                                        <TextBlock>
                                            Blank auto-discovers the local iVMS-4200 / NVMS V3 install.<LineBreak/>
                                            <LineBreak/>
                                            Otherwise give the person database itself<LineBreak/>
                                            (…\UserData\PersonalManagement.S\PersonalManagement)<LineBreak/>
                                            or the site's UserData folder.
                                        </TextBlock>
                                    </TextBox.ToolTip>
                                </TextBox>
                                <Button Grid.Row="1" Grid.Column="2" Content="Browse…"
                                        Click="OnBrowseIvmsDb" Margin="6,3,0,3" Padding="10,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Database key"
                                           VerticalAlignment="Center"/>
                                <PasswordBox x:Name="IvmsKeyBox" Grid.Row="2" Grid.Column="1" Margin="0,3">
                                    <PasswordBox.ToolTip>
                                        <TextBlock>
                                            The per-install SQLCipher key, base64. Blank uses the IVMS_DB_KEY<LineBreak/>
                                            environment variable or the key cached for this install.<LineBreak/>
                                            <LineBreak/>
                                            DVRTool never derives this key and never displays it back.
                                        </TextBlock>
                                    </PasswordBox.ToolTip>
                                </PasswordBox>
                                <Button Grid.Row="2" Grid.Column="2" Content="Cache key"
                                        Click="OnCacheIvmsKey" Margin="6,3,0,3" Padding="10,2"/>

                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                            Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Import CSV…" Click="OnImportIdentityCsv"
                                            Padding="10,4"/>
                                    <Button Content="Import from iVMS database" Click="OnImportFromIvms"
                                            Margin="8,0,0,0" Padding="10,4"/>
                                    <Button Content="Clear map" Click="OnClearIdentityMap"
                                            Margin="8,0,0,0" Padding="10,4"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <DataGrid x:Name="AccessGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" Margin="0,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Card" Width="110"
                                                    Binding="{Binding Card}"/>
                                <DataGridTextColumn Header="Name" Width="180"
                                                    Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="Panel" Width="130"
                                                    Binding="{Binding Panel}"/>
                                <DataGridTextColumn Header="Doors" Width="90"
                                                    Binding="{Binding Doors}"/>
                                <DataGridTextColumn Header="Valid" Width="70"
                                                    Binding="{Binding Valid}"/>
                                <DataGridTextColumn Header="Valid until" Width="150"
                                                    Binding="{Binding ValidUntil}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Storage">
                    <DockPanel>
                        <ToolBar DockPanel.Dock="Top">
                            <TextBlock Text="System " VerticalAlignment="Center"/>
                            <ComboBox x:Name="StorageDeviceCombo" Width="220"
                                      DisplayMemberPath="DisplayLabel"/>
                            <Button Content="Load" Click="OnLoadStorage" Margin="8,0,0,0"/>
                            <CheckBox x:Name="StorageOldestCheck" Content="Per-camera oldest footage"
                                      IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0">
                                <CheckBox.ToolTip>
                                    <TextBlock>
                                        Asks the recorder for the earliest recording still on disk,<LineBreak/>
                                        camera by camera — one search per camera, so a big system<LineBreak/>
                                        over a slow link takes a few extra seconds. Uncheck for a<LineBreak/>
                                        quick disks-and-bitrates look.
                                    </TextBlock>
                                </CheckBox.ToolTip>
                            </CheckBox>
                        </ToolBar>

                        <TextBlock x:Name="StorageWarning" DockPanel.Dock="Top" Margin="2,4,2,0"
                                   TextWrapping="Wrap" Foreground="DarkRed" FontWeight="Bold"
                                   Visibility="Collapsed"/>

                        <GroupBox DockPanel.Dock="Bottom" Margin="0,6,0,0"
                                  Header="Retention planner — “we need X days”">
                            <DockPanel Margin="4">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <TextBlock Text="Target days " VerticalAlignment="Center"/>
                                    <TextBox x:Name="StorageTargetDaysBox" Width="60"/>
                                    <Button Content="Preview plan" Click="OnPreviewStoragePlan"
                                            Margin="8,0,0,0" Padding="10,2"/>
                                    <Button x:Name="StorageApplyButton" Content="Apply plan…"
                                            Click="OnApplyStoragePlan" Margin="8,0,0,0" Padding="10,2"
                                            IsEnabled="False">
                                        <Button.ToolTip>
                                            <TextBlock>
                                                Writes the planned max bitrate to every camera the plan<LineBreak/>
                                                changes, one by one, and reads each value back. Asks for<LineBreak/>
                                                confirmation first — this changes recording quality and<LineBreak/>
                                                how many days the disks hold.
                                            </TextBlock>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="Pin selected camera(s) at " VerticalAlignment="Center"/>
                                    <TextBox x:Name="StoragePinKbpsBox" Width="60">
                                        <TextBox.ToolTip>
                                            <TextBlock>
                                                The rate to hold, in kbps. Leave it blank to hold whatever<LineBreak/>
                                                the camera is set to now — the planner re-reads that each<LineBreak/>
                                                time, so a number here is the stronger promise.
                                            </TextBlock>
                                        </TextBox.ToolTip>
                                    </TextBox>
                                    <TextBlock Text=" kbps (blank = as-is) " VerticalAlignment="Center"/>
                                    <Button Content="Pin" Click="OnPinStorageCameras"
                                            Margin="4,0,0,0" Padding="10,2">
                                        <Button.ToolTip>
                                            <TextBlock>
                                                Pinned cameras are the ones the planner may not decide for:<LineBreak/>
                                                their bitrate is spent from the budget first and the rest is<LineBreak/>
                                                split across the others. Pins are saved per system and shared<LineBreak/>
                                                with the dvrtool CLI; pinning writes nothing to the recorder.
                                            </TextBlock>
                                        </Button.ToolTip>
                                    </Button>
                                    <Button Content="Unpin" Click="OnUnpinStorageCameras"
                                            Margin="8,0,0,0" Padding="10,2"/>
                                    <Button Content="Clear all pins" Click="OnClearStoragePins"
                                            Margin="8,0,0,0" Padding="10,2"/>
                                </StackPanel>
                                <TextBlock x:Name="StoragePinSummary" DockPanel.Dock="Top"
                                           Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#333"/>
                                <TextBlock x:Name="StoragePlanSummary" Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>
                            </DockPanel>
                        </GroupBox>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <GroupBox Grid.Row="0" Header="Disks">
                                <DockPanel>
                                    <TextBlock x:Name="StorageDiskSummary" DockPanel.Dock="Top"
                                               Margin="2,2,2,4" TextWrapping="Wrap"/>
                                    <DataGrid x:Name="StorageHddGrid" AutoGenerateColumns="False"
                                              IsReadOnly="True" CanUserAddRows="False"
                                              MaxHeight="150" Margin="0,2">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Bay" Width="45"
                                                                Binding="{Binding Bay}"/>
                                            <DataGridTextColumn Header="Status" Width="80"
                                                                Binding="{Binding Status}"/>
                                            <DataGridTextColumn Header="Capacity" Width="80"
                                                                Binding="{Binding Capacity}"/>
                                            <DataGridTextColumn Header="Free" Width="80"
                                                                Binding="{Binding Free}"/>
                                            <DataGridTextColumn Header="Type" Width="60"
                                                                Binding="{Binding Type}"/>
                                            <DataGridTextColumn Header="Model" Width="200"
                                                                Binding="{Binding Model}"/>
                                            <DataGridTextColumn Header="Serial" Width="*"
                                                                Binding="{Binding Serial}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox Grid.Row="1" Header="Cameras (recording / main stream)">
                                <DockPanel>
                                    <TextBlock x:Name="StorageCameraSummary" DockPanel.Dock="Top"
                                               Margin="2,2,2,4" TextWrapping="Wrap"/>
                                    <DataGrid x:Name="StorageCameraGrid" AutoGenerateColumns="False"
                                              IsReadOnly="True" CanUserAddRows="False" Margin="0,2">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Ch" Width="40"
                                                                Binding="{Binding Ch}"/>
                                            <DataGridTextColumn Header="Name" Width="150"
                                                                Binding="{Binding Name}"/>
                                            <DataGridTextColumn Header="Codec" Width="60"
                                                                Binding="{Binding Codec}"/>
                                            <DataGridTextColumn Header="Resolution" Width="80"
                                                                Binding="{Binding Resolution}"/>
                                            <DataGridTextColumn Header="FPS" Width="45"
                                                                Binding="{Binding Fps}"/>
                                            <DataGridTextColumn Header="Mode" Width="55"
                                                                Binding="{Binding Mode}"/>
                                            <DataGridTextColumn Header="Recording" Width="150"
                                                                Binding="{Binding Recording}">
                                                <DataGridTextColumn.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="ToolTip" Value="{Binding RecordingDetail}"/>
                                                        <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
                                                    </Style>
                                                </DataGridTextColumn.CellStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Max kbps" Width="70"
                                                                Binding="{Binding MaxKbps}"/>
                                            <DataGridTextColumn Header="Pin" Width="70"
                                                                Binding="{Binding Pin}">
                                                <DataGridTextColumn.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="ToolTip" Value="{Binding PinDetail}"/>
                                                        <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
                                                    </Style>
                                                </DataGridTextColumn.CellStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Planned" Width="70"
                                                                Binding="{Binding Planned}"/>
                                            <DataGridTextColumn Header="Oldest footage" Width="135"
                                                                Binding="{Binding Oldest}"/>
                                            <DataGridTextColumn Header="Days" Width="55"
                                                                Binding="{Binding Days}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </GroupBox>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Config">
                    <DockPanel>
                        <ToolBar DockPanel.Dock="Top">
                            <TextBlock Text="System " VerticalAlignment="Center"/>
                            <ComboBox x:Name="ConfigDeviceCombo" Width="220"
                                      DisplayMemberPath="DisplayLabel"/>
                            <Button Content="Read" Click="OnLoadConfig" Margin="8,0,0,0"/>
                            <Separator/>
                            <Button Content="Fleet clocks" Click="OnAuditFleetClocks"
                                    Padding="10,2">
                                <Button.ToolTip>
                                    <TextBlock>
                                        Reads the clock and the time source of every saved recorder —<LineBreak/>
                                        two small requests each — and says which ones are out.<LineBreak/>
                                        <LineBreak/>
                                        This is the reason the tab exists: footage search, the timeline<LineBreak/>
                                        and export filenames all run on the recorder's own wall clock,<LineBreak/>
                                        so a recorder an hour out stamps the wrong hour onto everything<LineBreak/>
                                        it writes.
                                    </TextBlock>
                                </Button.ToolTip>
                            </Button>
                        </ToolBar>

                        <TextBlock x:Name="ConfigWarning" DockPanel.Dock="Top" Margin="2,4,2,0"
                                   TextWrapping="Wrap" Foreground="DarkRed" FontWeight="Bold"
                                   Visibility="Collapsed"/>

                        <GroupBox DockPanel.Dock="Top" Header="Fleet clocks" Margin="0,4,0,0">
                            <DockPanel>
                                <TextBlock x:Name="ConfigFleetSummary" DockPanel.Dock="Top"
                                           Margin="2,2,2,4" TextWrapping="Wrap"/>
                                <DataGrid x:Name="ConfigFleetGrid" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False"
                                          MaxHeight="170" Margin="0,2">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Recorder" Width="150"
                                                            Binding="{Binding Device}"/>
                                        <DataGridTextColumn Header="Its clock" Width="135"
                                                            Binding="{Binding Clock}"/>
                                        <DataGridTextColumn Header="Drift" Width="95"
                                                            Binding="{Binding Drift}"/>
                                        <DataGridTextColumn Header="Time source" Width="85"
                                                            Binding="{Binding Source}"/>
                                        <DataGridTextColumn Header="Verdict" Width="*"
                                                            Binding="{Binding Verdict}">
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="ToolTip" Value="{Binding Detail}"/>
                                                    <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox DockPanel.Dock="Bottom" Header="Change the time source (writes)"
                                  Margin="0,6,0,0">
                            <DockPanel Margin="4">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <TextBlock Text="NTP server " VerticalAlignment="Center"/>
                                    <TextBox x:Name="ConfigNtpServerBox" Width="150"/>
                                    <TextBlock Text=" port " VerticalAlignment="Center"/>
                                    <TextBox x:Name="ConfigNtpPortBox" Width="50"/>
                                    <TextBlock Text=" every " VerticalAlignment="Center"/>
                                    <TextBox x:Name="ConfigNtpIntervalBox" Width="45"/>
                                    <TextBlock Text=" min " VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ConfigNtpEnabledCheck" Content="NTP on"
                                              VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                            Margin="0,6,0,0">
                                    <TextBlock Text="Time zone " VerticalAlignment="Center"/>
                                    <TextBox x:Name="ConfigZoneBox" Width="330">
                                        <TextBox.ToolTip>
                                            <TextBlock>
                                                The vendor's OWN value: a Hikvision timeZone string, a Dahua<LineBreak/>
                                                zone index. There is no reliable mapping from an IANA zone name,<LineBreak/>
                                                and a wrong mapping mis-sets the clock silently — which is the<LineBreak/>
                                                fault this tab exists to catch. Copy the value from a recorder<LineBreak/>
                                                of the same vendor that is right.
                                            </TextBlock>
                                        </TextBox.ToolTip>
                                    </TextBox>
                                    <CheckBox x:Name="ConfigDstCheck" Content="DST"
                                              VerticalAlignment="Center" Margin="8,0,0,0">
                                        <CheckBox.ToolTip>
                                            <TextBlock>
                                                Dahua's own daylight-saving switch. Hikvision folds DST into the<LineBreak/>
                                                zone string and has no switch, so this is disabled there.
                                            </TextBlock>
                                        </CheckBox.ToolTip>
                                    </CheckBox>
                                    <TextBlock Text="  Name " VerticalAlignment="Center"/>
                                    <TextBox x:Name="ConfigNameBox" Width="150"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                            Margin="0,6,0,0">
                                    <Button x:Name="ConfigApplyButton" Content="Apply…"
                                            Click="OnApplyConfig" Padding="10,2" IsEnabled="False">
                                        <Button.ToolTip>
                                            <TextBlock>
                                                Writes only the fields you changed, then reads the recorder back<LineBreak/>
                                                and shows what it actually kept. Asks for confirmation first.<LineBreak/>
                                                <LineBreak/>
                                                Reversible from this same tab, which is why it has a button here —<LineBreak/>
                                                changing a LAN address or a service port is not, and is<LineBreak/>
                                                deliberately not offered anywhere in DVRTool.
                                            </TextBlock>
                                        </Button.ToolTip>
                                    </Button>
                                    <Button x:Name="ConfigSyncNowButton" Content="Set clock from this PC…"
                                            Click="OnSyncConfigClock" Margin="8,0,0,0" Padding="10,2"
                                            IsEnabled="False">
                                        <Button.ToolTip>
                                            <TextBlock>
                                                Stamps this workstation's wall clock onto the recorder.<LineBreak/>
                                                Refused on a recorder that syncs from NTP — a hand-set clock<LineBreak/>
                                                there is overwritten at the next sync and hides the real cause,<LineBreak/>
                                                which is usually the zone or the DST switch.
                                            </TextBlock>
                                        </Button.ToolTip>
                                    </Button>
                                    <TextBlock x:Name="ConfigWriteResult" Margin="12,0,0,0"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </GroupBox>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Row="0" Grid.ColumnSpan="2" Header="Clock">
                                <TextBlock x:Name="ConfigClockText" Margin="4"
                                           TextWrapping="Wrap"
                                           FontFamily="Consolas, Segoe UI"/>
                            </GroupBox>

                            <GroupBox Grid.Row="1" Grid.Column="0" Header="Service ports">
                                <DataGrid x:Name="ConfigPortGrid" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False" Margin="0,2">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Protocol" Width="110"
                                                            Binding="{Binding Protocol}"/>
                                        <DataGridTextColumn Header="Port" Width="55"
                                                            Binding="{Binding Port}"/>
                                        <DataGridTextColumn Header="State" Width="65"
                                                            Binding="{Binding State}"/>
                                        <DataGridTextColumn Header="Allowed" Width="130"
                                                            Binding="{Binding Range}">
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="ToolTip" Value="{Binding RangeDetail}"/>
                                                    <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Saved record" Width="*"
                                                            Binding="{Binding Saved}">
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="ToolTip" Value="{Binding SavedDetail}"/>
                                                    <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <GroupBox Grid.Row="1" Grid.Column="1" Header="Network and notes">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="4">
                                        <TextBlock x:Name="ConfigNetworkText" TextWrapping="Wrap"
                                                   FontFamily="Consolas, Segoe UI"/>
                                        <TextBlock x:Name="ConfigNotesText" Margin="0,8,0,0"
                                                   TextWrapping="Wrap" Foreground="#333"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </GroupBox>
                        </Grid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
