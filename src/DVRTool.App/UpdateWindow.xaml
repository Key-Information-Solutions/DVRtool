<Window x:Class="DVRTool.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install update" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="OnLoaded" Closing="OnClosing">
    <StackPanel Margin="14">
        <TextBlock x:Name="Headline" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
        <TextBlock x:Name="Detail" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#444"/>
        <ProgressBar x:Name="Progress" Height="18" Margin="0,12,0,0" Minimum="0" Maximum="100"/>
        <TextBlock x:Name="ProgressText" Margin="0,4,0,0" FontFamily="Consolas, Segoe UI"/>
        <TextBlock x:Name="Ready" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   Text="Verified against the signed manifest. Installing closes DVRTool, runs the installer (Windows will ask to allow it once), and reopens DVRTool when it finishes."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="InstallButton" Content="Install and restart" Padding="12,4" IsEnabled="False"
                    IsDefault="True" Click="OnInstall"/>
            <Button x:Name="CancelButton" Content="Cancel" Padding="12,4" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
