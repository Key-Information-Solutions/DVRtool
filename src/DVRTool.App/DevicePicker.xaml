<UserControl x:Class="DVRTool.App.DevicePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ToggleButton x:Name="Toggle" Checked="OnDropdownOpened" Padding="6,2"
                      HorizontalContentAlignment="Left">
            <TextBlock x:Name="Label" TextTrimming="CharacterEllipsis"/>
        </ToggleButton>
        <Popup StaysOpen="False" Placement="Bottom"
               PlacementTarget="{Binding ElementName=Toggle}"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}">
            <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1" Padding="6" MinWidth="230">
                <StackPanel>
                    <StackPanel x:Name="BulkButtons" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="All" Click="OnSelectAll" Padding="10,1"/>
                        <Button Content="None" Click="OnSelectNone" Margin="6,0,0,0" Padding="10,1"/>
                    </StackPanel>
                    <TextBlock x:Name="EmptyText" FontStyle="Italic" Foreground="Gray"
                               TextWrapping="Wrap" MaxWidth="260" Visibility="Collapsed"/>
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ChoiceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}"
                                              IsChecked="{Binding IsSelected}"
                                              Checked="OnChoiceToggled" Unchecked="OnChoiceToggled"
                                              Margin="0,2,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
