<Project>
  <!-- The one product version. Every assembly is stamped with it, and the installer's
       ProductVersion defaults to it (installer/DVRTool.Installer.wixproj) — so the number the
       running app compares against a release manifest is the number the MSI upgrade logic
       compares too. Bump at least the third field for every shipped build (docs/updates.md);
       release.ps1 does this. Numeric x.y.z only: it is also the MSI ProductVersion. -->
  <PropertyGroup>
    <Version>1.1.3</Version>
  </PropertyGroup>
</Project>
